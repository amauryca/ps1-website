  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.15.29",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "wait-on": "^8.0.5",
    "vite": "^6.0.0"
  }
}