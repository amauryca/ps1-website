    <title>Spotify Sign-In</title>
  </head>
  <body style="margin:0;background:#071735;color:#f4f7ff;font:16px -apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;display:grid;place-items:center;min-height:100vh;">
